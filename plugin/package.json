{
  "name": "dsh-plugin-notch-balance",
  "version": "1.4.0",
  "private": true,
  "description": "Launches DSHNotch on macOS and bridges DSH session events to native notifications on macOS and Windows (Windows tray app → Electron toast + taskbar unread badge → PowerShell fallback).",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "session-cost.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
