{
  "name": "dsh-plugin-notch-balance",
  "version": "1.8.0",
  "private": true,
  "description": "Launches DSHNotch on macOS, bridges DSH session events to native notifications, enhances the DSH client with a sidebar balance ring and Codex-style composer predictions, and tracks the running step with an inline run-trace pill.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "prediction.js",
    "session-cost.js",
    "activity.js",
    "lid-sleep.js",
    "lid-sleep",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
